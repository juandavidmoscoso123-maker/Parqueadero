@page
@model Parquing.Pages.IndexModel
@{
    ViewData["Title"] = "Control de Caja - Parqueadero";
}

<div class="container mt-4">
    <h2 class="mb-4">Control Rápido de Ingresos</h2>

    <!-- Tarjetas de Resumen para la Caja -->
    <div class="row text-white mb-4">
        <div class="col-md-4">
            <div class="card bg-primary p-3 shadow-sm">
                <h5>Total en Caja</h5>
                <h3>$ @Model.TotalCaja.ToString("N0")</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success p-3 shadow-sm">
                <h5>Carros ($10k)</h5>
                <h3>@Model.TotalCarros</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning p-3 shadow-sm text-dark">
                <h5>Motos ($5k)</h5>
                <h3>@Model.TotalMotos</h3>
            </div>
        </div>
    </div>

    <!-- Botones de Registro Rápido -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">Registrar Ingreso al Instante</div>
        <div class="card-body text-center py-4">
            <form method="post" class="d-flex justify-content-center gap-4">
                <button type="submit" asp-page-handler="RegistrarMoto"
                        class="btn btn-warning btn-lg px-5 py-3 fw-bold text-dark shadow">

                    🛵 Entró una Moto
                    ($ @Model.PrecioMotoActual.ToString("N0"))

                </button>


                <button type="submit" asp-page-handler="RegistrarCarro"
                        class="btn btn-success btn-lg px-5 py-3 fw-bold shadow">

                    🚗 Entró un Carro
                    ($ @Model.PrecioCarroActual.ToString("N0"))

                </button>
            </form>
        </div>
    </div>

    <!-- Botón que abre el modal o formulario -->
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCorreo">
        📧 Enviar Reporte por Correo
    </button>

    <!-- Panel flotante (Modal) -->
    <div class="modal fade" id="modalCorreo" tabindex="-1" aria-labelledby="modalCorreoLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <!-- 1. Envolvemos todo en un form que apunta a C# -->
                <form method="post" asp-page-handler="EnviarReporte">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalCorreoLabel">Guardar Correo para Informe Diario</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="inputCorreo" class="form-label">Escribe tu correo:</label>
                            <!-- 2. Importante: el name="correoDestino" conecta este input con el código de C# -->
                            <input type="email" class="form-control" id="inputCorreo" name="correoDestino" required
                                   placeholder="ejemplo@correo.com">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <!-- 3. El botón pasa a ser type="submit" para que envíe el formulario -->
                        <button type="submit" class="btn btn-success">Guardar y Enviar</button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    
    
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Tipo de Vehículo</th>
                <th>Hora de Ingreso</th>
                <th>Valor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ListaVehiculos)
            {
                <tr>
                    <td>
                        @if (item.Tipo == "Carro")
                        {
                            <span class="badge bg-success">Carro</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Moto</span>
                        }
                    </td>
                    <td>@item.HoraIngreso.ToString("hh:mm:ss tt")</td>
                    <td>$ @item.ValorCobrado.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>
</div>


<!-- Botón para abrir la ventana -->


<button type="button" class="btn btn-secondary boton-precios" data-bs-toggle="modal" data-bs-target="#modalPrecios">
    ⚙️
</button>


<style>
    .boton-precios {
        position: absolute;
        top: 40px;
        right: 20px;

        font-size: 20px;
        padding: 20px 20px;
    }
</style>


<!-- Ventana para configurar precios -->
<div class="modal fade" id="modalPrecios" tabindex="-1" aria-labelledby="modalPreciosLabel" aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form method="post" asp-page-handler="ActualizarTarifas">

                <div class="modal-header">

                    <h5 class="modal-title" id="modalPreciosLabel">
                        ⚙️ Configurar precios
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label">
                            🛵 Precio de la Moto
                        </label>

                        <input type="number" class="form-control" name="precioMoto" value="@Model.PrecioMotoActual"
                               min="0" step="100">

                    </div>


                    <div class="mb-3">

                        <label class="form-label">
                            🚗 Precio del Carro
                        </label>

                        <input type="number" class="form-control" name="precioCarro" value="@Model.PrecioCarroActual"
                               min="0" step="100">

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-success">
                        💾 Guardar precios
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>